
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ccpg-producteurs-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ccpg-producteurs-pilote",
      "database_id": "60bb6620-342f-401a-a3c1-5c0e3b4c1ddc"
    }
  ]
}
